msgstr "Язык по умолчанию должен входить в число доступных языков."

#: models.py:782 serializers.py:126
msgid "The base currency is required."
msgstr "Укажите базовую валюту."

#: models.py:800 serializers.py:140
msgid ""
"The base currency cannot be changed while currency rates with another base "
"currency exist."
msgstr ""
"Базовую валюту нельзя изменить, пока существуют курсы с другой базовой "
"валютой."

#: models.py:809 serializers.py:149
msgid ""
"The base currency cannot be changed while base values in another currency "
"exist."
msgstr ""
"Базовую валюту нельзя изменить, пока существуют базовые величины в другой "
"валюте."

