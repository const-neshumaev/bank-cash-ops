# Keep every text file on LF both in the repository and in the working tree, so
# sources behave identically on Windows and inside Linux containers (a CRLF in
# *.sh breaks the container entrypoint). See AGENTS.md and .editorconfig.
* text=auto eol=lf

# Native Windows scripts keep CRLF for cmd.exe and PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
