# Production image for the BankCashOps frontend (static build served by nginx).
# Build context is the repository root so the build can include the module
# frontends that live in modules/ (see docs/modules.md). They are copied under
# the frontend root as ./modules so Node module resolution finds node_modules.

# --- Build stage ----------------------------------------------------------- #
FROM node:22-alpine AS build

# Patch the Alpine packages of the base image; a cached node:22-alpine tag may
# still carry outdated OS libraries with published vulnerabilities.
RUN apk upgrade --no-cache

# Keep the npm CLI and the dependencies it vendors at their current patched
# versions instead of the ones pinned into the Node image.
RUN npm install -g npm@12.2.1

# npm 12.2.1 still vendors undici 6.29.0 and ip-address 10.7.2, which have
# published advisories. Substitute the patched releases without touching the
# rest of the bundled CLI.
RUN mkdir -p /tmp/npm-patch \
    && cd /tmp/npm-patch \
    && npm init -y > /dev/null \
    && npm install --silent undici@6.29.1 ip-address@10.7.4 \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/undici \
    && rm -rf /usr/local/lib/node_modules/npm/node_modules/ip-address \
    && cp -a /tmp/npm-patch/node_modules/undici /usr/local/lib/node_modules/npm/node_modules/undici \
    && cp -a /tmp/npm-patch/node_modules/ip-address /usr/local/lib/node_modules/npm/node_modules/ip-address \
    && rm -rf /tmp/npm-patch

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
COPY modules/ ./modules/
RUN npm run build

# --- Serve stage ----------------------------------------------------------- #
# The stable nginx branch tracks security fixes; the former 1.27 mainline image
# had fallen behind it.
FROM nginx:stable-alpine

# Same as above for the packages of the serving base image.
RUN apk upgrade --no-cache

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
