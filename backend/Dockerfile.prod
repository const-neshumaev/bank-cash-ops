# Production image for the BankCashOps backend (gunicorn, no dev tooling).
# Build context is the repository root so the image can include both the Django
# host project (backend/) and the vertical modules (modules/).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_COLLECTSTATIC=1

WORKDIR /app

# Install the dependencies with a current pip. pip is not kept in the final image
# (see below), so this only makes the build use an up-to-date resolver.
RUN pip install --upgrade "pip~=26.2"

# Patch the Debian packages of the base image and install the translation
# toolchain in a single layer. The floating ``python:3.12-slim`` tag may keep a
# cached image alive whose OS libraries already have published vulnerabilities.
#
# ``gettext`` provides ``msgfmt``/``xgettext`` for ``compilemessages`` (see the
# internationalisation section of docs/development.md). Unlike the development
# image it is not needed at runtime: the catalogs are compiled below and the
# toolchain is then removed, so the shipped image carries neither gettext nor the
# ``libxml2`` it pulls in.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends gettext \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
RUN pip install -r requirements.txt

COPY backend/ ./
COPY modules/ /app/modules/

# Compile the translation catalogs into the image (``.mo`` files are not
# committed, and the runtime has no translations toolchain), then drop gettext
# together with the dependencies only it needed. ``compilemessages`` loads the
# settings, which require a DATABASE_URL even though no database is contacted.
RUN DJANGO_SECRET_KEY=build-only \
    DATABASE_URL=postgres://build:build@localhost:5432/build \
    python manage.py compilemessages \
    && apt-get purge -y --auto-remove gettext \
    && rm -rf /var/lib/apt/lists/*

# ``collectstatic`` loads the settings, which require a DATABASE_URL even
# though no database is contacted while collecting static files.
RUN chmod +x /app/entrypoint.sh \
    && DJANGO_SECRET_KEY=build-only \
       DATABASE_URL=postgres://build:build@localhost:5432/build \
       python manage.py collectstatic --noinput

# The runtime image needs no package installation: dropping pip also drops the
# outdated libraries it vendors (msgpack, setuptools, urllib3) from the image.
RUN python -m pip uninstall -y pip

EXPOSE 8000

# Run the entrypoint through sh and strip carriage returns first: a file checked
# out on Windows may carry CRLF, which breaks a POSIX shell script.
ENTRYPOINT ["sh", "-c", "tr -d '\\r' < /app/entrypoint.sh > /tmp/entrypoint.sh && exec sh /tmp/entrypoint.sh \"$@\"", "--"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60"]
