# --------------------------------------------------------------------------- #
# BankCashOps — example environment file.
# Copy it to ".env" before the first start:  cp .env.example .env
# The values below are meant for development only; replace every secret before
# deploying with docker-compose.prod.yml (it forces DJANGO_DEBUG=False and
# requires a real DJANGO_SECRET_KEY).
# --------------------------------------------------------------------------- #

# --- Django backend -------------------------------------------------------- #
# Generate a long random value for production and keep it out of version control.
DJANGO_SECRET_KEY=insecure-development-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Europe/Moscow

# Collect static files on container start. The production image turns this on by
# itself (backend/Dockerfile.prod); in development runserver serves them directly.
# DJANGO_COLLECTSTATIC=1

# Comma separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bank-wide default language, used when neither the user preference nor the
# Accept-Language header is present. Supported values: ru, en.
BCO_DEFAULT_LANGUAGE=ru

# --- Database (PostgreSQL) ------------------------------------------------- #
# PostgreSQL is the only database engine (docs/adr/0002-postgresql-in-development.md).
# Docker Compose creates the "db" service with these credentials and publishes it
# on the host at POSTGRES_HOST_PORT.
POSTGRES_DB=bankcashops
POSTGRES_USER=bankcashops
POSTGRES_PASSWORD=bankcashops
POSTGRES_HOST_PORT=5433

# Connection string used by Django. It is required — there is no SQLite fallback.
# Inside the compose network docker-compose.yml assembles this value from the
# POSTGRES_* settings above and points it at "db:5432"; the value below fits
# Django started on the host against the published port.
DATABASE_URL=postgres://bankcashops:bankcashops@localhost:5433/bankcashops

# --- Initial administrator ------------------------------------------------- #
# Created automatically on the first start if the account does not exist yet.
# Leave the credentials empty to skip creating the administrator.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_FIRST_NAME=System
DJANGO_SUPERUSER_LAST_NAME=Administrator

# --- JWT ------------------------------------------------------------------- #
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Login throttling ------------------------------------------------------ #
# Rate limit for the login endpoint, in DRF notation (<number>/<period>).
LOGIN_THROTTLE_RATE=20/min

# --- Frontend -------------------------------------------------------------- #
# Vite dev server proxy target (inside Docker the backend is reachable as "backend").
VITE_API_PROXY_TARGET=http://backend:8000
