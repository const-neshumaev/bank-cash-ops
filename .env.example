# --------------------------------------------------------------------------- #
# BankCashOps — example environment file.
# Copy it to ".env" before the first start:  cp .env.example .env
# --------------------------------------------------------------------------- #

# --- Django backend -------------------------------------------------------- #
DJANGO_SECRET_KEY=insecure-development-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Europe/Moscow

# Comma separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------- #
# Leave DATABASE_URL empty to use SQLite (the default for development).
# Set it to a connection string to switch to PostgreSQL, for example:
#   DATABASE_URL=postgres://bankcashops:bankcashops@db:5432/bankcashops
DATABASE_URL=
SQLITE_PATH=/app/data/db.sqlite3

# --- Initial administrator ------------------------------------------------- #
# Created automatically on the first start if the account does not exist yet.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_FIRST_NAME=System
DJANGO_SUPERUSER_LAST_NAME=Administrator

# --- JWT ------------------------------------------------------------------- #
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Frontend -------------------------------------------------------------- #
# Dev server proxy target (inside Docker the backend is reachable as "backend").
VITE_API_PROXY_TARGET=http://backend:8000
